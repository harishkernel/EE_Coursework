      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">12</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function Sn = S(Ux,Uy)
theta=atan2(Uy,Ux)*180/pi;
if theta&gt;=0&amp;&amp;theta&lt;60
    Sn=1;
elseif theta&gt;=60&amp;&amp;theta&lt;120
    Sn=2;
elseif theta&gt;=120&amp;&amp;theta&lt;180
    Sn=3;
elseif theta&gt;=-180&amp;&amp;theta&lt;-120
    Sn=4;
elseif theta&gt;=-120&amp;&amp;theta&lt;-60
    Sn=5;
else Sn=6;
end</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[302.0, 250.0, 500.0, 341.0]</P>
        <P Name="fimathString">fimath(...
&apos;RoundMode&apos;, &apos;floor&apos;,...
&apos;OverflowMode&apos;, &apos;wrap&apos;,...
