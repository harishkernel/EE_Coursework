<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[181, 439, 621, 831]</P>
  <P Name="PaperType">A4</P>
  <Block BlockType="Inport" Name="Id" SID="446">
    <P Name="Position">[320, 38, 350, 52]</P>
    <P Name="ZOrder">-1</P>
    <P Name="BlockMirror">on</P>
  </Block>
  <Block BlockType="SubSystem" Name="Discrete Tranfer Function" SID="447">
    <PortCounts in="1" out="1"/>
    <P Name="Position">[95, 20, 165, 70]</P>
    <P Name="ZOrder">-2</P>
    <P Name="BlockMirror">on</P>
    <Mask>
      <Type>First Order Low Pass Filter (Discrete)</Type>
      <Display>plot(X,Y);
disp(str);
</Display>
      <Description>H(s)=1/(1+T.s)</Description>
      <Initialization> X=[0 1 2 3 4];
 Y=[-2 -2 -3 -4 -4];
 str=sprintf(&apos;\nH=1/(1+T.s)\n T= %g s\n\n\n&apos;,T);
num=1;
den=[T 1];

% discrete transfer function
% descending powers of z
numd= Ts/T;
dend=[ 1  (Ts-T)/T];

</Initialization>
      <MaskParameter Name="T" Type="edit">
        <Prompt>Time constant T (s) :</Prompt>
        <Value>0.1557</Value>
      </MaskParameter>
      <MaskParameter Name="Ts" Type="edit">
        <Prompt>Time step (s)</Prompt>
        <Value>Ts</Value>
      </MaskParameter>
    </Mask>
    <System Ref="system_447"/>
  </Block>
  <Block BlockType="Gain" Name="Lm" SID="451">
    <P Name="Position">[220, 27, 280, 63]</P>
    <P Name="ZOrder">-3</P>
    <P Name="BlockMirror">on</P>
    <P Name="Gain">34.7e-3</P>
    <P Name="ParamDataTypeStr">Inherit: Same as input</P>
    <P Name="OutDataTypeStr">Inherit: Same as input</P>
    <P Name="SaturateOnIntegerOverflow">on</P>
  </Block>
  <Block BlockType="Outport" Name="Phir" SID="452">
    <P Name="Position">[25, 38, 55, 52]</P>
    <P Name="ZOrder">-4</P>
    <P Name="BlockMirror">on</P>
  </Block>
  <Line>
    <P Name="ZOrder">1</P>
    <P Name="Src">447#out:1</P>
    <P Name="Dst">452#in:1</P>
  </Line>
  <Line>
    <P Name="ZOrder">2</P>
    <P Name="Src">446#out:1</P>
    <P Name="Dst">451#in:1</P>
  </Line>
  <Line>
    <P Name="ZOrder">3</P>
    <P Name="Src">451#out:1</P>
    <P Name="Dst">447#in:1</P>
  </Line>
  <Annotation SID="681">
    <P Name="Name">Phir = Lm *Id  / (1 +Tr .s) </P>
    <P Name="Position">[38, 111, 152, 126]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-1</P>
  </Annotation>
  <Annotation SID="682">
    <P Name="Name">Lm = 34.7 mH</P>
    <P Name="Position">[42, 132, 106, 147]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-2</P>
  </Annotation>
  <Annotation SID="683">
    <P Name="Name">Lr = Ll&apos;r +Lm = 0.8 +34.7= 35.5 mH</P>
    <P Name="Position">[46, 172, 203, 187]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-3</P>
  </Annotation>
  <Annotation SID="684">
